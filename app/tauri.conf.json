{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ddlin",
  "version": "0.1.0",
  "identifier": "io.github.ddlin",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DDlin",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES",
      "../LICENSE": "LICENSE"
    },
    "category": "Reference",
    "shortDescription": "EPWING dictionary viewer",
    "linux": {
      "deb": {
        "desktopTemplate": "ddlin.desktop"
      },
      "rpm": {
        "desktopTemplate": "ddlin.desktop"
      }
    }
  }
}
